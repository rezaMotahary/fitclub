# FitClub — نمونهٔ متغیرهای محیطی (اسرار واقعی commit نشوند)
# کپی عملی برای API: api/.env.example → api/.env

# --- API (localhost:3001) ---
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://fitsteel:fitsteel_dev@localhost:5432/fitsteel?schema=public"

SESSION_COOKIE_NAME=fitclub_session
SESSION_TTL_DAYS=7

# OTP عضو. تا وقتی کاوه‌نگار خاموش است، همین کد ثابت کار می‌کند — فقط لوکال.
# روی سرور (NODE_ENV=production) نباید باشد؛ API با آن روشن نمی‌شود. → docs/security.md
OTP_DEV_CODE=123456

# سرور تستی/آموزشی مالک (تصمیم ۱۴۰۴/۰۸/۱۰): کد ثابت + رمز نمونه روی سرور هم مجاز، پیامک نمی‌رود.
# DEMO_MODE اجازهٔ پاک کردن دیتابیس را نمی‌دهد. روی سرور: npm run bootstrap:server
# وب هم: NEXT_PUBLIC_DEMO_MODE=true و NEXT_PUBLIC_SITE_URL=https://…
DEMO_MODE=false

# محدودیت تلاش (هر بازدیدکننده در دقیقه / هر شماره برای کد)
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_STAFF_LOGIN_PER_MIN=10
RATE_LIMIT_OTP_REQUEST_PER_MIN=5
RATE_LIMIT_OTP_VERIFY_PER_MIN=10
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_PER_PHONE_PER_HOUR=5
# پشت nginx روی سرور: 1
TRUST_PROXY=

# کاوه‌نگار — کلید واقعی فقط در api/.env (داخل گیت نرود).
# پیامک واقعی فقط با KAVENEGAR_ENABLED=true روشن می‌شود. پیش‌فرض خاموش است.
KAVENEGAR_ENABLED=false
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# مسیر مخفی پنل منشی/مدیر — فقط در web/.env.local؛ مقدار واقعی را در گیت نگذار
# STAFF_PATH_SECRETARY=replace-me
# STAFF_PATH_ADMIN=replace-me

# --- رمزهای نمونهٔ seed (فقط لوکال؛ در prisma/sample-credentials.ts) ---
# مدیر:   admin@fitclub.local     / FitClubAdmin1!
# منشی:   secretary@fitclub.local / FitClubSecretary1!
# عضو تست OTP: موبایل 09121234567 + کد OTP_DEV_CODE
# عضو آرشیو (ورود ممنوع): 09129990000
