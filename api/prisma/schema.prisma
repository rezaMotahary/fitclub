// FitClub domain model
// Source: docs/product-overview.md · docs/project-identity.md · docs/business-rules.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  SECRETARY
  ADMIN
}

enum SessionGender {
  MEN
  WOMEN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum PaymentMethod {
  CASH
  CARD_READER
  CARD_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum AttendanceResult {
  SUCCESS
  REJECTED_WEEKLY_CAP
  REJECTED_EXPIRED
  REJECTED_DEBT
  REJECTED_OTHER
  REJECTED_OUTSIDE_SESSION
  REJECTED_ALREADY_INSIDE
  REJECTED_ARCHIVED
  REJECTED_NOT_STARTED
}

model User {
  id           String        @id @default(cuid())
  phone        String?       @unique
  email        String?       @unique
  passwordHash String?
  role         Role
  fullName     String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  member       Member?
  staffProfile StaffProfile?
  sessions     Session[]
  checkIns     Attendance[]  @relation("RecordedBy")
  voidedAttendances Attendance[] @relation("VoidedBy")
}

model Member {
  id             String         @id @default(cuid())
  membershipCode String         @unique
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate      DateTime?
  sessionGender  SessionGender
  joinedAt       DateTime       @default(now())
  debtAmount     Int            @default(0) // toman
  coachName      String?
  notes          String?
  isArchived     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscriptions  Subscription[]
  attendances    Attendance[]
  payments       Payment[]
}

model StaffProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftLabel String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  daysPerWeek   Int
  priceToman    Int
  durationDays  Int            @default(30)
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  memberId               String
  member                 Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan               @relation(fields: [planId], references: [id])
  status                 SubscriptionStatus @default(ACTIVE)
  startsAt               DateTime
  endsAt                 DateTime
  priceToman             Int                @default(0)
  amountPaidToman        Int                @default(0)
  discountPercentApplied Int                @default(0)
  autoRenewHint          Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  payments               Payment[]

  @@index([memberId, status])
  @@index([endsAt])
}

model Attendance {
  id                  String           @id @default(cuid())
  memberId            String
  member              Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkInAt           DateTime
  checkOutAt          DateTime?
  durationMinutes     Int?
  result              AttendanceResult @default(SUCCESS)
  rejectReason        String?
  recordedById        String?
  recordedBy          User?            @relation("RecordedBy", fields: [recordedById], references: [id])
  closedAutomatically Boolean          @default(false)
  voidReason          String?
  voidedAt            DateTime?
  voidedById          String?
  voidedBy            User?            @relation("VoidedBy", fields: [voidedById], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([memberId, checkInAt])
  @@index([checkInAt])
  @@index([checkOutAt])
}

model Payment {
  id             String        @id @default(cuid())
  memberId       String
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amountToman    Int
  method         PaymentMethod
  status         PaymentStatus @default(CONFIRMED)
  title          String
  paidAt         DateTime      @default(now())
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([memberId, paidAt])
  @@index([subscriptionId])
}

model ClubSettings {
  id                          String   @id @default("default")
  earlyRenewalDiscountPercent Int      @default(10)
  sessionSchedule             Json     @default("{\"men\": {\"fri\": {\"open\": \"16:00\", \"close\": \"21:00\"}, \"mon\": {\"open\": \"15:00\", \"close\": \"23:00\"}, \"sat\": {\"open\": \"15:00\", \"close\": \"23:00\"}, \"sun\": {\"open\": \"15:00\", \"close\": \"23:00\"}, \"thu\": {\"open\": \"15:00\", \"close\": \"22:00\"}, \"tue\": {\"open\": \"15:00\", \"close\": \"23:00\"}, \"wed\": {\"open\": \"15:00\", \"close\": \"23:00\"}}, \"women\": {\"fri\": {\"open\": null, \"close\": null}, \"mon\": {\"open\": \"07:00\", \"close\": \"14:30\"}, \"sat\": {\"open\": \"07:00\", \"close\": \"14:30\"}, \"sun\": {\"open\": \"07:00\", \"close\": \"14:30\"}, \"thu\": {\"open\": \"07:00\", \"close\": \"13:30\"}, \"tue\": {\"open\": \"07:00\", \"close\": \"14:30\"}, \"wed\": {\"open\": \"07:00\", \"close\": \"14:30\"}}}")
  updatedAt                   DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([userId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
  @@index([phone, createdAt])
}
