NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# After PostgreSQL is installed, set a real local URL, e.g.:
# DATABASE_URL="postgresql://fitsteel:fitsteel_dev@localhost:5432/fitsteel?schema=public"
DATABASE_URL="postgresql://fitsteel:fitsteel_dev@localhost:5432/fitsteel?schema=public"

# Session cookie (httpOnly) for staff + member panels
SESSION_COOKIE_NAME=fitclub_session
SESSION_TTL_DAYS=7

# Member OTP (no real SMS provider in MVP skeleton)
# In development: code is logged to API console, and/or this fixed code works.
OTP_DEV_CODE=123456
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
