NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# After PostgreSQL is installed, set a real local URL, e.g.:
# DATABASE_URL="postgresql://fitsteel:fitsteel_dev@localhost:5432/fitsteel?schema=public"
DATABASE_URL="postgresql://fitsteel:fitsteel_dev@localhost:5432/fitsteel?schema=public"

# Session cookie (httpOnly) for staff + member panels
SESSION_COOKIE_NAME=fitclub_session
SESSION_TTL_DAYS=7

# Member OTP. Fixed code is used only when Kavenegar is not configured.
OTP_DEV_CODE=123456

# Kavenegar — put the real key only in api/.env (never commit it).
# When both values are set, member login texts a one-time code and OTP_DEV_CODE is ignored.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
