NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# After PostgreSQL is installed, set a real local URL, e.g.:
# DATABASE_URL="postgresql://fitsteel:fitsteel_dev@localhost:5432/fitsteel?schema=public"
DATABASE_URL="postgresql://fitsteel:fitsteel_dev@localhost:5432/fitsteel?schema=public"

# Session cookie (httpOnly) for staff + member panels
SESSION_COOKIE_NAME=fitclub_session
SESSION_TTL_DAYS=7

# Member OTP. Fixed code is used while Kavenegar is switched off — local only.
# With NODE_ENV=production the API refuses to start if OTP_DEV_CODE is set,
# and member login needs Kavenegar switched on.
OTP_DEV_CODE=123456

# Public test / teaching server only: accept OTP_DEV_CODE and sample staff passwords
# in production, never send SMS, allow seeding. Keep false for a real club.
DEMO_MODE=false

# Kavenegar — put the real key only in api/.env (never commit it).
# Real SMS sends only when KAVENEGAR_ENABLED=true and the key and sender are set.
KAVENEGAR_ENABLED=false
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Abuse limits (per visitor IP per minute, and per phone for login codes)
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_STAFF_LOGIN_PER_MIN=10
RATE_LIMIT_OTP_REQUEST_PER_MIN=5
RATE_LIMIT_OTP_VERIFY_PER_MIN=10
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_PER_PHONE_PER_HOUR=5

# Production behind nginx / a proxy: set to 1 so limits see the real visitor IP
TRUST_PROXY=
